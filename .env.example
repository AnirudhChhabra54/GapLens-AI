# ==============================================================================
# GapLens AI — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose secret keys in client-side code!

# ------------------------------------------------------------------------------
# 1. Supabase Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Server-only service role key (NEVER expose to client side / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Google AI Studio API Key (used for gemini-3.8-flash and gemini-embedding-001)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# Alternatively supported by @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Optional verified model overrides
GEMINI_GENERATION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS="768"

# ------------------------------------------------------------------------------
# 3. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. Demo Judge Account Configuration (Pre-seeded OS CS-301)
# ------------------------------------------------------------------------------
DEMO_USER_EMAIL="demo@gapfinder.ai"
DEMO_USER_ID="00000000-0000-0000-0000-000000000001"

# Only required if a protected remote demo reseed operation is enabled.
# DEMO_SEED_SECRET="replace-with-a-one-time-secret"
