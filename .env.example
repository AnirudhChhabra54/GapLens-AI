# ==============================================================================
# GapLens AI — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose secret keys in client-side code!

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable / Anon key (safe for browser and server client queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Server-only service role or secret key (NEVER expose to client side / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-secret-key"
SUPABASE_SECRET_KEY="your-service-role-or-secret-key"

# ------------------------------------------------------------------------------
# 2. Groq Cloud LLM Configuration (Primary Generation Engine)
# ------------------------------------------------------------------------------
# Found in Groq Console (https://console.groq.com/keys)
GROQ_API_KEY="gsk_your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# ------------------------------------------------------------------------------
# 3. Jina AI Configuration (Primary 768d Dense Embeddings)
# ------------------------------------------------------------------------------
# Found in Jina AI Dashboard (https://jina.ai/)
JINA_API_KEY="jina_your-jina-api-key-here"
JINA_EMBEDDING_MODEL="jina-embeddings-v5-text-nano"
JINA_EMBEDDING_DIMENSIONS="768"
JINA_BASE_URL="https://api.jina.ai/v1/embeddings"

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Configuration (Secondary Fallback)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (optional fallback when Groq/Jina are not configured)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_GENERATION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS="768"

# ------------------------------------------------------------------------------
# 5. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 6. Demo Judge Account Configuration (Pre-seeded OS CS-301)
# ------------------------------------------------------------------------------
DEMO_USER_EMAIL="demo@gapfinder.ai"
DEMO_USER_ID="00000000-0000-0000-0000-000000000001"
